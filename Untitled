        "z450": sum(r["today"]["zone_450g"] for r in rows),
        "z650": sum(r["today"]["zone_650g"] for r in rows),
        "late": sum(r["today"]["late_zone"] for r in rows),
        "cold": sum(r["today"]["over_3time_single"] for r in rows),
        "games_sum": sum((r["html"].get("total_start") or 0) for r in rows),
