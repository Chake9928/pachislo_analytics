                reasons.append(f"650帯まで残り{zone['remain']}G")
            elif zone.get("start", 0) >= 900:
                score -= 3
                risks.append(f"高ゲーム数滞在（{zone['start']}G）天井寄り")

        # last 3 days already paid a lot
        if last3_avg_slump is not None and last3_avg_slump >= 2000:
            score -= 5
            risks.append(f"直近3日平均最終差枚が厚い（{last3_avg_slump}）")
        elif last3_avg_slump is not None and last3_avg_slump <= -800:
