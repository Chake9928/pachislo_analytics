    store_daily_out = []
    for d in data["store_daily"]:
        late = d["over_zone_650g"] + d["zone_1000g"]
        store_daily_out.append({
            "date": d["data_date"],
            "zone_special": d["zone_special"],
            "zone_650g": d["zone_650g"],
            "late": late,
            "cold": d["over_3time_single"],
            "z150": d["zone_150g"],
            "z450": d["zone_450g"],
        })

    out = {
        "today": TODAY.isoformat(),
        "complete_dates": complete_dates,
        "last3_dates": last3_dates,
        "last7_dates": last7_dates,
        "med_hist": med_hist,
        "med_l3": med_l3,
        "island_today": island_today,
        "island_final": island_final,
        "store_daily": store_daily_out,
        "rows": rows,
    }
    out_path = Path("data/setting/100928/1/_tmp_target_0901.json")
    out_path.write_text(json.dumps(out, ensure_ascii=False, default=str), encoding="utf-8")
    print(f"[SAVE] {out_path}", flush=True)


if __name__ == "__main__":
